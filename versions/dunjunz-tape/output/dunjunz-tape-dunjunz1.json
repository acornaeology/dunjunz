    {
      "addr": 8192,
      "name": "loader_start",
      "title": "Prepare the screen and load the game",
      "description": "Entered from DUNK's loader at &0740, which loads this file to &2000 and jumps here. It does *FX 200,3 (clear memory on BREAK), selects MODE 2 with the cursor off and the 6845 showing 25 character rows, as in play, and makes logical colours 1-7 black and colour 8 green, so the loading screen arrives unseen. It sets a three-row text window at the bottom, rows 22-24, in colour 8, then calls load_files and jumps to load_core in the game, which loads the last file and starts it.",
      "on_exit": {
        "A": "corrupted",
        "X": "corrupted",
        "Y": "corrupted"
      }
    },
    {
      "addr": 8391,
      "name": "load_file",
      "title": "Load a file through FILEV",
      "description": "Load the file that osfile_block names to the load address in it, by calling the filing system's FILEV routine directly: its address is copied into the operand of this routine's own JSR, then called with A = &FF (load). With *TAPE selected, as TITLE left it, the file comes from the cassette. The caller sets the filename's address and the load address's low two bytes; this routine clears the top two.",
      "on_entry": {
        "osfile_block": "filename address and load address, bytes 0-3"
      },
      "on_exit": {
        "A": "corrupted",
        "X": "corrupted",
        "Y": "corrupted"
      }
    },
    {
      "addr": 8421,
      "name": "load_files",
      "title": "Load the loading screen and two game files",
      "description": "Load Dunjunz2, the loading screen, to &3280; restore the default colours (VDU 20), which shows it at once, clear the text window and set colour 2; then load Dunjunz3 to &6E80 and Dunjunz4 to &08C0. Each file is named by one of the filenames after the code and loaded by load_file.",
      "on_exit": {
        "A": "corrupted",
        "X": "corrupted",
        "Y": "corrupted"
      }
    }
  ],
